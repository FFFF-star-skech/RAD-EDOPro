 constexpr int STEP_PERCENT = 5;
 constexpr int DEFAULT_PERCENT = 85;
 
+// A timeline override lives only for the current replay. A value of 0 means
+// "follow the user's normal replay pace setting".
+inline int timeline_override_percent = 0;
+
 constexpr int ClampPercent(int percent) {
 	return percent < MIN_PERCENT ? MIN_PERCENT : (percent > MAX_PERCENT ? MAX_PERCENT : percent);
 }
 
+inline void SetTimelinePercent(int percent) {
+	timeline_override_percent = ClampPercent(percent);
+}
+
+inline void ClearTimelinePercent() {
+	timeline_override_percent = 0;
+}
+
+inline bool HasTimelinePercent() {
+	return timeline_override_percent != 0;
+}
+
+inline int EffectivePercent(int user_percent) {
+	return timeline_override_percent ? timeline_override_percent : ClampPercent(user_percent);
+}

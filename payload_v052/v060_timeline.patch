+#ifndef REPLAY_TIMELINE_H
+#define REPLAY_TIMELINE_H
+
+#include <cstdint>
+#include "core_utils.h"
+
+namespace ygo::ReplayTimeline {
+
+// RAD-only replay packet. Standard .yrpX files never contain this packet.
+constexpr uint8_t MESSAGE_ID = 232;
+constexpr uint8_t VERSION = 1;
+constexpr uint32_t MAX_WAIT_MS = 10u * 60u * 1000u;
+
+enum class Op : uint8_t {
+	Pace = 1,
+	Wait = 2,
+	Reset = 3,
+	Pause = 4,
+};
+
+struct Command {
+	Op op{ Op::Reset };
+	uint32_t value{};
+};
+
+inline bool Parse(const CoreUtils::Packet& packet, Command& out) {
+	if(packet.message != MESSAGE_ID || packet.buff_size() != 6)
+		return false;
+	const auto* data = packet.data();
+	if(data[0] != VERSION)
+		return false;
+	const auto raw_op = data[1];
+	if(raw_op < static_cast<uint8_t>(Op::Pace) || raw_op > static_cast<uint8_t>(Op::Pause))
+		return false;
+	out.op = static_cast<Op>(raw_op);
+	out.value = static_cast<uint32_t>(data[2])
+		| (static_cast<uint32_t>(data[3]) << 8)
+		| (static_cast<uint32_t>(data[4]) << 16)
+		| (static_cast<uint32_t>(data[5]) << 24);
+	return true;
+}
+
+} // namespace ygo::ReplayTimeline
+
+#endif // REPLAY_TIMELINE_H

diff --git a/new/edopro/gframe/replay_pace.h b/edopro/gframe/replay_pace.h
new file mode 100644
index 0000000..b78aea6
--- /dev/null
+++ b/edopro/gframe/replay_pace.h
@@ -0,0 +1,33 @@
+#ifndef REPLAY_PACE_H
+#define REPLAY_PACE_H
+
+#include <cstdint>
+
+namespace ygo::ReplayPace {
+
+constexpr int MIN_PERCENT = 50;
+constexpr int MAX_PERCENT = 150;
+constexpr int STEP_PERCENT = 5;
+constexpr int DEFAULT_PERCENT = 85;
+
+constexpr int ClampPercent(int percent) {
+	return percent < MIN_PERCENT ? MIN_PERCENT : (percent > MAX_PERCENT ? MAX_PERCENT : percent);
+}
+
+constexpr int ScaleMilliseconds(int milliseconds, bool is_replay, bool is_catching_up, int pace_percent) {
+	if(milliseconds <= 0 || !is_replay || is_catching_up)
+		return milliseconds;
+	const int pace = ClampPercent(pace_percent);
+	const int64_t scaled = (static_cast<int64_t>(milliseconds) * 100 + pace / 2) / pace;
+	return scaled < 1 ? 1 : static_cast<int>(scaled);
+}
+
+constexpr int WaitMillisecondsFromFrames(int frames, bool quick_animation, bool is_replay, bool is_catching_up, int pace_percent) {
+	const int effective_frames = (quick_animation && frames >= 12) ? 12 : frames;
+	const int milliseconds = effective_frames * 1000 / 60;
+	return ScaleMilliseconds(milliseconds, is_replay, is_catching_up, pace_percent);
+}
+
+} // namespace ygo::ReplayPace
+
+#endif // REPLAY_PACE_H
